<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.santelims.controllers.AuditLogController"
      spacing="10" style="-fx-padding: 15;">

    <Label text="Audit Logs" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colEmail" text="User" prefWidth="200"/>
            <TableColumn fx:id="colAction" text="Action" prefWidth="150"/>
            <TableColumn fx:id="colDetails" text="Details" prefWidth="350"/>
            <TableColumn fx:id="colTime" text="Timestamp" prefWidth="180"/>
        </columns>
    </TableView>

</VBox>