<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.santelims.controllers.RegisterController"
      style="-fx-padding: 40;">

    <Label text="Create Account" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="fullNameField" promptText="Full Name" maxWidth="300"/>
    <TextField fx:id="emailField" promptText="Email" maxWidth="300"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="300"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" maxWidth="300"/>

    <Button text="Register" onAction="#handleRegister" maxWidth="300"/>
    <Button text="Back to Login" onAction="#handleBackToLogin" maxWidth="300"/>

    <Label fx:id="messageLabel"/>

</VBox>
