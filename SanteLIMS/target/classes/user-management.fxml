<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.santelims.controllers.UserManagementController"
      spacing="10" style="-fx-padding: 15;">

    <Label text="User Management" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- FORM -->
    <HBox spacing="10">
        <TextField fx:id="fullNameField" promptText="Full Name" prefWidth="150"/>
        <TextField fx:id="emailField" promptText="Email" prefWidth="180"/>
        <PasswordField fx:id="passwordField" promptText="Password" prefWidth="130"/>
        <ComboBox fx:id="roleComboBox" promptText="Role" prefWidth="140"/>
        <Button text="Add User" onAction="#handleAddUser"/>
        <Button text="Delete Selected" onAction="#handleDeleteUser"/>
    </HBox>

    <Label fx:id="messageLabel" textFill="red"/>

    <!-- TABLE -->
    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colName" text="Full Name" prefWidth="160"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colRole" text="Role" prefWidth="130"/>
        </columns>
    </TableView>

</VBox>
