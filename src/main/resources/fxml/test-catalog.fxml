<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sante.lims.controller.RequestController"
            stylesheets="@/styles/app.css">

    <top>
        <VBox spacing="10" styleClass="top-bar">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>
            <Label text="Test Catalog" styleClass="title"/>
            <HBox spacing="10">
                <Button text="Back to Dashboard" onAction="#backToDashboard"/>
                <Button text="Request History" onAction="#openHistory"/>
                <Button text="Result Vault" onAction="#openResultVault"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="content-pane">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>

            <Label text="Browse tests, pricing, and turnaround time" styleClass="section-title"/>
            <TableView fx:id="catalogTable" prefHeight="560">
                <columns>
                    <TableColumn fx:id="colName" text="Test Name" prefWidth="240"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="170"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="150"/>
                    <TableColumn fx:id="colTat" text="TAT" prefWidth="130"/>
                    <TableColumn fx:id="colFormat" text="Result Format" prefWidth="170"/>
                </columns>
            </TableView>

            <Button text="Place Selected Order" onAction="#placeOrder" styleClass="primary-btn"/>
        </VBox>
    </center>
</BorderPane>
