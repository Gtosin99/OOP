<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sante.lims.controller.CustomerController"
            stylesheets="@/styles/app.css">

    <top>
        <VBox spacing="10" styleClass="top-bar">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>
            <Label text="Customer Dashboard" styleClass="title"/>
            <HBox spacing="20">
                <Label text="Name:" styleClass="meta-label"/>
                <Label fx:id="lblName"/>
                <Label text="Email:" styleClass="meta-label"/>
                <Label fx:id="lblEmail"/>
                <Label text="Verification:" styleClass="meta-label"/>
                <Label fx:id="lblVerification"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="16" styleClass="content-pane">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>

            <HBox spacing="10">
                <Button text="Test Catalog" onAction="#openCatalog"/>
                <Button text="Request History" onAction="#openHistory"/>
                <Button text="Result Vault" onAction="#openVault"/>
                <Button text="Refresh" onAction="#refreshDashboard"/>
                <Button text="Log Out" onAction="#logout"/>
            </HBox>

            <Label text="Active Requests" styleClass="section-title"/>
            <TableView fx:id="activeRequestsTable" prefHeight="260">
                <columns>
                    <TableColumn fx:id="colTestName" text="Test" prefWidth="230"/>
                    <TableColumn fx:id="colRequestDate" text="Requested" prefWidth="180"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="180"/>
                    <TableColumn fx:id="colCountdown" text="Time Remaining" prefWidth="180"/>
                </columns>
            </TableView>

            <Label text="Notifications" styleClass="section-title"/>
            <TableView fx:id="notificationsTable" prefHeight="240">
                <columns>
                    <TableColumn fx:id="colSubject" text="Subject" prefWidth="220"/>
                    <TableColumn fx:id="colMessage" text="Message" prefWidth="430"/>
                    <TableColumn fx:id="colCreated" text="Date" prefWidth="170"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
