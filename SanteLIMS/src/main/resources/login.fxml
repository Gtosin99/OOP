<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.santelims.controllers.LoginController"
      style="-fx-padding: 40;">

    <Label text="Sante LIMS Login"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="emailField" promptText="Email" maxWidth="300"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="300"/>

    <Button text="Login" onAction="#handleLogin" maxWidth="300"/>
    <Button text="Create Account" onAction="#handleRegister" maxWidth="300"/>

    <Label fx:id="messageLabel" textFill="red"/>

</VBox>