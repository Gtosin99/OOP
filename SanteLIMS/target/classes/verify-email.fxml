<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.santelims.controllers.VerifyEmailController"
      style="-fx-padding: 40;">

    <Label text="Verify Your Email"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Check your console for the verification token."
           style="-fx-text-fill: gray;"/>

    <TextField fx:id="tokenField"
               promptText="Enter Verification Token" maxWidth="300"/>

    <Button text="Verify" onAction="#handleVerify" maxWidth="300"/>
    <Button text="Back to Login" onAction="#handleBackToLogin" maxWidth="300"/>

    <Label fx:id="messageLabel"/>

</VBox>
