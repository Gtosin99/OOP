<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" alignment="CENTER" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sante.lims.controllers.LoginController"
      stylesheets="@../styles/app.css">
    <padding>
        <Insets top="32" right="40" bottom="32" left="40" />
    </padding>
    <Label text="Sante Diagnostics LIMS" style="-fx-font-size: 24; -fx-font-weight: bold;" />
    <TextField fx:id="emailField" promptText="Email" maxWidth="340" />
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="340" />
    <Button text="Login" onAction="#handleLogin" maxWidth="340" />
    <Button text="Customer Registration" onAction="#handleRegister" maxWidth="340" />
    <Label fx:id="messageLabel" style="-fx-text-fill: #b91c1c;" wrapText="true" maxWidth="340" />
</VBox>
