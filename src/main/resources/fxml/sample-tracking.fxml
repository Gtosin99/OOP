<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sante.lims.controllers.SampleController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16" />
    </padding>

    <Label text="Sample Lifecycle Tracking" style="-fx-font-size: 18; -fx-font-weight: bold;" />

    <HBox spacing="8">
        <TextField fx:id="requestIdField" promptText="Test request ID" prefWidth="180" />
        <Button text="Load Sample" onAction="#loadSample" />
        <Button text="Create Sample" onAction="#createSample" />
    </HBox>

    <GridPane hgap="10" vgap="8">
        <Label text="Sample ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="sampleIdLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Current Status:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="currentStatusLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    </GridPane>

    <HBox spacing="8">
        <ComboBox fx:id="statusComboBox" prefWidth="220" />
        <Button text="Update Status" onAction="#updateStatus" />
    </HBox>

    <Label text="Status History" style="-fx-font-weight: bold;" />
    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="220" />
            <TableColumn fx:id="updatedByColumn" text="Updated By" prefWidth="180" />
            <TableColumn fx:id="updatedAtColumn" text="Updated At" prefWidth="200" />
        </columns>
    </TableView>
</VBox>
