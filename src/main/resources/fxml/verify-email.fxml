<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" alignment="CENTER" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sante.lims.controllers.VerifyEmailController">
    <padding>
        <Insets top="32" right="40" bottom="32" left="40" />
    </padding>
    <Label text="Verify Email" style="-fx-font-size: 22; -fx-font-weight: bold;" />
    <TextField fx:id="emailField" promptText="Email" maxWidth="340" />
    <TextField fx:id="tokenField" promptText="Verification token" maxWidth="340" />
    <Button text="Verify" onAction="#handleVerify" maxWidth="340" />
    <Button text="Back to Login" onAction="#backToLogin" maxWidth="340" />
    <Label fx:id="messageLabel" wrapText="true" maxWidth="340" />
</VBox>
