<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sante.lims.controllers.TestBuilderController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16" />
    </padding>
    <Label text="Custom Test Builder" style="-fx-font-size: 18; -fx-font-weight: bold;" />
    <GridPane hgap="8" vgap="8">
        <TextField fx:id="testNameField" promptText="Test name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="categoryField" promptText="Category" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <TextField fx:id="priceField" promptText="Price" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="tatField" promptText="TAT hours" GridPane.columnIndex="3" GridPane.rowIndex="0" />
        <ComboBox fx:id="resultFormatCombo" promptText="Format" prefWidth="130" GridPane.columnIndex="4" GridPane.rowIndex="0" />
    </GridPane>
    <HBox spacing="8">
        <Button text="Add" onAction="#handleAdd" />
        <Button text="Update" onAction="#handleUpdate" />
        <Button text="Deactivate" onAction="#handleDelete" />
        <Button text="Clear" onAction="#handleClear" />
        <Label fx:id="messageLabel" />
    </HBox>
    <TableView fx:id="testTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60" />
            <TableColumn fx:id="colName" text="Name" prefWidth="190" />
            <TableColumn fx:id="colCategory" text="Category" prefWidth="150" />
            <TableColumn fx:id="colPrice" text="Price" prefWidth="100" />
            <TableColumn fx:id="colTat" text="TAT" prefWidth="90" />
            <TableColumn fx:id="colFormat" text="Format" prefWidth="110" />
        </columns>
    </TableView>
</VBox>
