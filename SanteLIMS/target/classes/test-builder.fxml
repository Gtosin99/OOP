<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.santelims.controllers.TestBuilderController"
      spacing="10" style="-fx-padding: 15;">

    <Label text="Test Builder" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- FORM -->
    <HBox spacing="10">
        <TextField fx:id="testNameField" promptText="Test Name" prefWidth="150"/>
        <TextField fx:id="categoryField" promptText="Category" prefWidth="130"/>
        <TextField fx:id="priceField" promptText="Price" prefWidth="80"/>
        <TextField fx:id="tatField" promptText="Turnaround Time" prefWidth="130"/>
        <ComboBox fx:id="resultFormatCombo" promptText="Result Format" prefWidth="130"/>
        <Button text="Add Test" onAction="#handleAdd"/>
        <Button text="Update Selected" onAction="#handleUpdate"/>
        <Button text="Delete Selected" onAction="#handleDelete"/>
        <Button text="Clear" onAction="#handleClear"/>
    </HBox>

    <Label fx:id="messageLabel"/>

    <!-- TABLE -->
    <TableView fx:id="testTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colName" text="Test Name" prefWidth="180"/>
            <TableColumn fx:id="colCategory" text="Category" prefWidth="130"/>
            <TableColumn fx:id="colPrice" text="Price" prefWidth="80"/>
            <TableColumn fx:id="colTat" text="TAT" prefWidth="130"/>
            <TableColumn fx:id="colFormat" text="Result Format" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>