<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sante.lims.controllers.RequestQueueController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16" />
    </padding>

    <Label text="Test Request Queue" style="-fx-font-size: 18; -fx-font-weight: bold;" />

    <HBox spacing="8">
        <TextField fx:id="searchField" promptText="Search customer, email, or test" HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="paymentFilter" prefWidth="130" />
        <ComboBox fx:id="statusFilter" prefWidth="190" />
        <Button text="Search" onAction="#refreshRequests" />
        <Button text="Mark Paid" onAction="#markSelectedRequestPaid" />
    </HBox>

    <TableView fx:id="requestTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="170" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="190" />
            <TableColumn fx:id="testColumn" text="Test" prefWidth="160" />
            <TableColumn fx:id="paymentColumn" text="Payment" prefWidth="100" />
            <TableColumn fx:id="expectedColumn" text="Expected Completion" prefWidth="170" />
            <TableColumn fx:id="statusColumn" text="Processing Status" prefWidth="150" />
        </columns>
    </TableView>
</VBox>
