<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sante.lims.controllers.UserManagementController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16" />
    </padding>
    <Label text="User Provisioning" style="-fx-font-size: 18; -fx-font-weight: bold;" />
    <GridPane hgap="8" vgap="8">
        <TextField fx:id="fullNameField" promptText="Full name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="emailField" promptText="Email" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <PasswordField fx:id="passwordField" promptText="Temporary password" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <ComboBox fx:id="roleComboBox" promptText="Role" prefWidth="170" GridPane.columnIndex="3" GridPane.rowIndex="0" />
    </GridPane>
    <HBox spacing="8">
        <Button text="Add User" onAction="#handleAddUser" />
        <Button text="Delete Selected" onAction="#handleDeleteUser" />
        <Label fx:id="messageLabel" />
    </HBox>
    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60" />
            <TableColumn fx:id="colName" text="Name" prefWidth="190" />
            <TableColumn fx:id="colEmail" text="Email" prefWidth="220" />
            <TableColumn fx:id="colRole" text="Role" prefWidth="150" />
            <TableColumn fx:id="colForceChange" text="Force Change" prefWidth="130" />
        </columns>
    </TableView>
</VBox>
