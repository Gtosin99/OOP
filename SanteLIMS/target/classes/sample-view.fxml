<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.santelims.controllers.SampleController"
      spacing="10" style="-fx-padding: 15;">

    <Label text="Sample Tracking" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- ADD SAMPLE FORM -->
    <HBox spacing="10">
        <TextField fx:id="patientNameField" promptText="Patient Name" prefWidth="160"/>
        <TextField fx:id="testNameField" promptText="Test Name" prefWidth="160"/>
        <DatePicker fx:id="collectionDatePicker" promptText="Collection Date" prefWidth="160"/>
        <Button text="Add Sample" onAction="#handleAddSample"/>
        <Button text="Delete Selected" onAction="#handleDeleteSample"/>
    </HBox>

    <!-- RESULT ENTRY (LAB ATTENDANT) -->
    <HBox spacing="10">
        <TextField fx:id="resultField" promptText="Enter Result for Selected Sample" prefWidth="300"/>
        <ComboBox fx:id="statusCombo" promptText="Update Status" prefWidth="160"/>
        <Button text="Save Result" onAction="#handleSaveResult"/>
        <Button text="Update Status" onAction="#handleUpdateStatus"/>
    </HBox>

    <Label fx:id="messageLabel"/>

    <!-- TABLE -->
    <TableView fx:id="sampleTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colPatient" text="Patient" prefWidth="160"/>
            <TableColumn fx:id="colTest" text="Test" prefWidth="160"/>
            <TableColumn fx:id="colDate" text="Collection Date" prefWidth="130"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
            <TableColumn fx:id="colResult" text="Result" prefWidth="200"/>
        </columns>
    </TableView>

</VBox>