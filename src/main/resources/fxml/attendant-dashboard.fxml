<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="contentPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sante.lims.controllers.LabAttendantController">
    <top>
        <VBox spacing="8" styleClass="top-bar">
            <padding>
                <Insets top="14" right="18" bottom="14" left="18" />
            </padding>
            <Label text="Lab Attendant Operations" styleClass="title" />
            <HBox spacing="10">
                <Button text="Request Queue" onAction="#showRequestQueue" />
                <Button text="Sample Tracking" onAction="#showSampleTracking" />
                <Button text="Result Upload" onAction="#showResultUpload" />
                <Button text="Log Out" onAction="#handleLogout" />
            </HBox>
        </VBox>
    </top>
</BorderPane>
