<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sante.lims.controllers.AuditLogController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16" />
    </padding>
    <HBox spacing="8">
        <Label text="Audit Trail" style="-fx-font-size: 18; -fx-font-weight: bold;" />
        <Button text="Refresh" onAction="#refreshLogs" />
        <Label fx:id="messageLabel" />
    </HBox>
    <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTime" text="Time" prefWidth="170" />
            <TableColumn fx:id="colUser" text="User" prefWidth="210" />
            <TableColumn fx:id="colAction" text="Action" prefWidth="150" />
            <TableColumn fx:id="colDescription" text="Description" prefWidth="420" />
        </columns>
    </TableView>
</VBox>
