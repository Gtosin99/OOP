<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.santelims.controllers.ChangePasswordController"
      style="-fx-padding: 40;">

    <Label text="Change Your Password"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="You must change your password before continuing."
           style="-fx-text-fill: orange;"/>

    <PasswordField fx:id="newPasswordField"
                   promptText="New Password" maxWidth="300"/>

    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirm Password" maxWidth="300"/>

    <Button text="Change Password"
            onAction="#handleChangePassword" maxWidth="300"/>

    <Label fx:id="messageLabel"/>

</VBox>
